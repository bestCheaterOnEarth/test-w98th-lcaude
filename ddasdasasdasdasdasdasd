local localPlayer = game:GetService("Players").LocalPlayer
local library = {flags = {}, setters = {}, listeners = {}, controls = {}, key = Enum.KeyCode.RightShift}
local Options = setmetatable({}, {__index = function(_, flag) return library.controls[flag] end})
library.Options = Options
library.Toggles = Options

local FONT_UI_URL = "https://github.com/sametexe001/luas/raw/refs/heads/main/fonts/windows-xp-tahoma.ttf"
local FONT_BOLD_URL = "https://github.com/sametexe001/luas/raw/refs/heads/main/fonts/TAHOMA-8PT-BOLD-WINDOWS-XP.TTF"
local LOGO_FONT_URL = nil

local black, white = Color3.new(0, 0, 0), Color3.new(1, 1, 1)

local theme = {
	window = Color3.fromRGB(23, 23, 23),
	panel = Color3.fromRGB(20, 19, 24),
	field = Color3.fromRGB(34, 34, 36),
	control = Color3.fromRGB(51, 51, 53),
	controlEdge = Color3.fromRGB(38, 38, 40),
	border = Color3.fromRGB(52, 52, 54),
	outline = black,
	text = Color3.fromRGB(198, 197, 204),
	textOff = Color3.fromRGB(160, 160, 166),
	dim = Color3.fromRGB(125, 125, 132),
	sep = Color3.fromRGB(62, 62, 68),
	accent = Color3.fromRGB(127, 110, 212),
	inline = Color3.fromRGB(75, 75, 75)
}
theme.headline = theme.accent:Lerp(black, 0.45)
theme.accentEdge = theme.accent:Lerp(black, 0.3)
theme.selected = theme.accent:Lerp(theme.window, 0.85)

local HEADER = 26
local fallback = Font.new("rbxasset://fonts/families/GothamSSm.json")

local function loadFont(name, url, style)
	local ok, result = pcall(function()
		local ttf, json = name .. ".ttf", name .. ".json"
		if not isfile(ttf) then writefile(ttf, game:HttpGet(url)) end
		writefile(json, HttpService:JSONEncode({name = name, faces = {{name = name, weight = 400, style = style or "normal", assetId = getcustomasset(ttf)}}}))
		return Font.new(getcustomasset(json))
	end)
	return ok and result or fallback
end

local uiFont = loadFont("tahomaxp", FONT_UI_URL, "Regular")
local boldFont = loadFont("tahomaboldxp", FONT_BOLD_URL, "Regular")
local logoFont = LOGO_FONT_URL and loadFont("distortlogo", LOGO_FONT_URL, "Regular") or Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)

local function tween(obj, prop, value, t) TweenService:Create(obj, TweenInfo.new(t or 0.15), {[prop] = value}):Play() end

local function fire(flag, value)
	if library.listeners[flag] then for _, fn in ipairs(library.listeners[flag]) do fn(value) end end
end

function library.listen(flag, fn)
	library.listeners[flag] = library.listeners[flag] or {}
	table.insert(library.listeners[flag], fn)
end

local function measure(str, font, size)
	local ok, width = pcall(function()
		local params = Instance.new("GetTextBoundsParams")
		params.Text, params.Font, params.Size, params.Width = str, font, size, 10000
		return TextService:GetTextBoundsAsync(params).X
	end)
	return ok and width or #str * 7
end

local function frame(parent, color, size, pos)
	local f = Instance.new("Frame", parent)
	f.BorderSizePixel, f.BackgroundColor3, f.Size, f.Position = 0, color, size, pos or UDim2.new()
	return f
end

local function stroke(obj, color, thickness, name, position)
	local s = Instance.new("UIStroke")
	s.Name, s.ApplyStrokeMode, s.LineJoinMode, s.BorderStrokePosition = name or "Stroke", Enum.ApplyStrokeMode.Border, Enum.LineJoinMode.Miter, position or Enum.BorderStrokePosition.Outer
	s.Color, s.Thickness, s.Parent = color or theme.border, thickness or 1, obj
	return s
end

local function outline(obj) return stroke(obj, theme.outline, 1, "OutLine", Enum.BorderStrokePosition.Outer) end
local function inline(obj, color) return stroke(obj, color or theme.border, 1, "InLine", Enum.BorderStrokePosition.Inner) end

local function box(parent, color, size, pos, inlineColor)
	local f = frame(parent, color, size, pos)
	outline(f)
	inline(f, inlineColor)
	return f
end

local function gradient(parent, c0, c1, rotation)
	local g = Instance.new("UIGradient", parent)
	g.Rotation, g.Color = rotation or 90, ColorSequence.new(c0, c1)
	return g
end

local function shade(obj, bottom) return gradient(obj, white, bottom or Color3.fromRGB(175, 175, 180)) end

local function text(parent, str, size, pos, align, font)
	local l = Instance.new("TextLabel", parent)
	l.BackgroundTransparency, l.BorderSizePixel, l.FontFace = 1, 0, font or uiFont
	l.TextSize, l.TextColor3, l.TextXAlignment = 12, theme.text, align or Enum.TextXAlignment.Left
	l.Text, l.Size, l.Position = str, size, pos or UDim2.new()
	return l
end

local function textStroke(label)
	local s = Instance.new("UIStroke")
	s.Color, s.Thickness, s.LineJoinMode, s.Parent = black, 1, Enum.LineJoinMode.Miter, label
	return s
end

local function hitbox(parent, size, pos)
	local b = Instance.new("TextButton", parent)
	b.AutoButtonColor, b.Text, b.BackgroundTransparency, b.BorderSizePixel = false, "", 1, 0
	b.Size, b.Position = size, pos or UDim2.new()
	return b
end

local function press(input) return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch end

local function drag(target, fn, state)
	local active = false
	target.InputBegan:Connect(function(i)
		if press(i) then active = true; if state then state(true) end; fn(i.Position) end
	end)
	UIS.InputChanged:Connect(function(i)
		if active and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fn(i.Position) end
	end)
	UIS.InputEnded:Connect(function(i)
		if press(i) and active then active = false; if state then state(false) end end
	end)
end

local function inside(obj, p)
	local a, s = obj.AbsolutePosition, obj.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

local openFrame, openAnchor

local function closePopup()
	if openFrame then openFrame.Visible = false; openFrame = nil end
end

local function openPopup(popup, anchor)
	local show = openFrame ~= popup
	closePopup()
	if show then
		local main = library.main
		local x = anchor.AbsolutePosition.X - main.AbsolutePosition.X
		local y = anchor.AbsolutePosition.Y - main.AbsolutePosition.Y + anchor.AbsoluteSize.Y + 4
		x = math.min(x, main.AbsoluteSize.X - popup.Size.X.Offset - 6)
		if y + popup.Size.Y.Offset > main.AbsoluteSize.Y - 4 then y = anchor.AbsolutePosition.Y - main.AbsolutePosition.Y - popup.Size.Y.Offset - 4 end
		popup.Position, popup.Visible = UDim2.fromOffset(x, y), true
		openFrame, openAnchor = popup, anchor
	end
end

UIS.InputBegan:Connect(function(i)
	if openFrame and press(i) and not inside(openFrame, i.Position) and not inside(openAnchor, i.Position) then closePopup() end
end)

function library.saveConfig()
	local json = HttpService:JSONEncode(library.flags)
	if writefile then writefile("distort_config.json", json) end
	return json
end

function library.loadConfig(json)
	if not json and readfile and isfile and isfile("distort_config.json") then json = readfile("distort_config.json") end
	if not json then return end
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok then return end
	for flag, value in pairs(data) do
		if library.setters[flag] then library.setters[flag](value) end
	end
end

local hudGui, hudArea, watermark, watermarkLabel

local function hud()
	if hudGui and hudGui.Parent then return hudGui end
	local parent = (gethui and gethui()) or localPlayer:WaitForChild("PlayerGui")
	local old = parent:FindFirstChild("DistortHud")
	if old then old:Destroy() end

	hudGui = Instance.new("ScreenGui", parent)
	hudGui.Name, hudGui.ResetOnSpawn, hudGui.IgnoreGuiInset, hudGui.ZIndexBehavior = "DistortHud", false, true, Enum.ZIndexBehavior.Sibling

	hudArea = Instance.new("Frame", hudGui)
	hudArea.Name, hudArea.BackgroundTransparency, hudArea.BorderSizePixel = "Notifications", 1, 0
	hudArea.Position, hudArea.Size = UDim2.fromOffset(8, 8), UDim2.fromOffset(400, 300)
	local areaList = Instance.new("UIListLayout", hudArea)
	areaList.Padding, areaList.SortOrder = UDim.new(0, 6), Enum.SortOrder.LayoutOrder

	watermark = box(hudGui, theme.window, UDim2.fromOffset(100, 22), UDim2.new(0.5, 0, 0, 8), theme.border)
	watermark.Name, watermark.AnchorPoint, watermark.Visible, watermark.ZIndex = "Watermark", Vector2.new(0.5, 0), false, 5
	shade(watermark, Color3.fromRGB(190, 190, 195))
	local wmLine = frame(watermark, theme.accent, UDim2.new(1, 0, 0, 2), UDim2.new())
	wmLine.ZIndex = 6
	watermarkLabel = text(watermark, "", UDim2.new(1, 0, 1, -2), UDim2.new(0, 0, 0, 2), Enum.TextXAlignment.Center, boldFont)
	watermarkLabel.ZIndex = 6
	textStroke(watermarkLabel)
	return hudGui
end

function library:SetWatermark(str)
	hud()
	watermarkLabel.Text = str
	watermark.Size = UDim2.fromOffset(measure(str, boldFont, 12) + 18, 22)
	watermark.Visible = true
end

function library:SetWatermarkVisibility(on) hud(); watermark.Visible = on and true or false end

function library:Notify(str, duration)
	hud()
	local width, height = measure(str, uiFont, 12) + 16, 22
	local note = box(hudArea, theme.window, UDim2.fromOffset(0, height), nil, theme.border)
	note.ClipsDescendants, note.ZIndex = true, 10
	shade(note, Color3.fromRGB(190, 190, 195))
	local bar = frame(note, theme.accent, UDim2.new(0, 3, 1, 0), UDim2.new())
	bar.ZIndex = 12
	local label = text(note, str, UDim2.new(1, -10, 1, 0), UDim2.new(0, 9, 0, 0))
	label.ZIndex, label.TextWrapped = 11, false
	textStroke(label)
	TweenService:Create(note, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(width, height)}):Play()
	task.spawn(function()
		task.wait(duration or 5)
		local out = TweenService:Create(note, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(0, height)})
		out:Play()
		out.Completed:Wait()
		note:Destroy()
	end)
end

function library:Unload()
	if library.gui then library.gui:Destroy() end
	if hudGui then hudGui:Destroy() end
end

local Column = {}
Column.__index = Column

function Column:UseHeader()
	if self.hasHeader then return end
	self.hasHeader = true
	self.header.Visible, self.line.Visible = true, true
	self.scroll.Position, self.scroll.Size = UDim2.new(0, 0, 0, HEADER + 1), UDim2.new(1, 0, 1, -(HEADER + 1))
end

function Column:Header(str)
	self:UseHeader()
	local label = text(self.header, str, UDim2.new(1, 0, 1, 0), UDim2.new(), Enum.TextXAlignment.Center, boldFont)
	label.TextColor3 = theme.accent
	return label
end

function Column:Section(title)
	local row = Instance.new("Frame", self.holder)
	row.BackgroundTransparency, row.BorderSizePixel, row.Size = 1, 0, UDim2.new(1, 0, 0, 16)
	text(row, title, UDim2.new(1, 0, 0, 16), UDim2.new(0, 1, 0, 0), nil, boldFont)
	frame(row, theme.border, UDim2.new(1, 0, 0, 1), UDim2.new(0, 0, 1, -2))
	return row
end

function Column:Label(str) return text(self.holder, str, UDim2.new(1, 0, 0, 16), UDim2.new(), nil, boldFont) end

function Column:Pages(names)
	self:UseHeader()
	local list = Instance.new("UIListLayout", self.header)
	list.FillDirection, list.HorizontalAlignment, list.VerticalAlignment, list.Padding, list.SortOrder = Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center, UDim.new(0, 8), Enum.SortOrder.LayoutOrder

	local pages, buttons, result = {}, {}, {}

	local function show(name)
		closePopup()
		for n, page in pairs(pages) do
			page.Visible = n == name
			tween(buttons[n], "TextColor3", n == name and theme.accent or theme.text)
		end
	end

	for i, name in ipairs(names) do
		if i > 1 then
			local slash = text(self.header, "/", UDim2.new(0, 6, 1, 0), UDim2.new(), Enum.TextXAlignment.Center, boldFont)
			slash.TextColor3, slash.LayoutOrder = theme.sep, i * 2 - 1
		end
		local button = Instance.new("TextButton", self.header)
		button.AutoButtonColor, button.BackgroundTransparency, button.BorderSizePixel = false, 1, 0
		button.AutomaticSize, button.Size, button.FontFace = Enum.AutomaticSize.X, UDim2.new(0, 0, 1, 0), boldFont
		button.TextSize, button.TextColor3, button.Text, button.LayoutOrder = 12, theme.text, name, i * 2
		button.MouseButton1Click:Connect(function() show(name) end)

		local page = Instance.new("Frame", self.holder)
		page.BackgroundTransparency, page.BorderSizePixel, page.Size = 1, 0, UDim2.new(1, 0, 0, 0)
		page.AutomaticSize, page.Visible = Enum.AutomaticSize.Y, false
		local pageList = Instance.new("UIListLayout", page)
		pageList.Padding, pageList.SortOrder = UDim.new(0, 2), Enum.SortOrder.LayoutOrder

		pages[name], buttons[name] = page, button
		table.insert(result, setmetatable({holder = page, scroll = self.scroll}, Column))
	end
	show(names[1])
	return table.unpack(result)
end

local function buildPicker(row, opts, offset)
	local flag = opts.flag or opts.text or tostring(row)
	local swatch = box(row, white, UDim2.new(0, 22, 0, 10), UDim2.new(1, -(offset + 22), 0.5, -5), Color3.fromRGB(30, 30, 30))
	local hit = hitbox(swatch, UDim2.new(1, 0, 1, 0))
	hit.ZIndex = 3

	local pop = box(library.main, theme.window, UDim2.new(0, 160, 0, 124), nil, theme.inline)
	pop.Visible, pop.ZIndex = false, 20

	local palette = box(pop, Color3.new(1, 0, 0), UDim2.new(1, -36, 1, -14), UDim2.new(0, 7, 0, 7), theme.controlEdge)
	local whiteLayer = frame(palette, white, UDim2.new(1, 0, 1, 0))
	Instance.new("UIGradient", whiteLayer).Transparency = NumberSequence.new(0, 1)
	local blackLayer = frame(palette, black, UDim2.new(1, 0, 1, 0))
	local fade = Instance.new("UIGradient", blackLayer)
	fade.Rotation, fade.Transparency = 90, NumberSequence.new(1, 0)
	local cursor = frame(palette, white, UDim2.new(0, 4, 0, 4))
	cursor.AnchorPoint, cursor.ZIndex = Vector2.new(0.5, 0.5), 2
	stroke(cursor, black)
	local paletteHit = hitbox(palette, UDim2.new(1, 0, 1, 0))
	paletteHit.ZIndex = 3

	local hueBar = box(pop, white, UDim2.new(0, 16, 1, -14), UDim2.new(1, -24, 0, 7), theme.controlEdge)
	local keys = {}
	for n = 0, 6 do table.insert(keys, ColorSequenceKeypoint.new(n / 6, Color3.fromHSV(n / 6, 1, 1))) end
	local hueGradient = Instance.new("UIGradient", hueBar)
	hueGradient.Rotation, hueGradient.Color = 90, ColorSequence.new(keys)
	local hueCursor = frame(hueBar, white, UDim2.new(1, 0, 0, 2))
	hueCursor.AnchorPoint, hueCursor.ZIndex = Vector2.new(0, 0.5), 2
	stroke(hueCursor, black)
	local hueHit = hitbox(hueBar, UDim2.new(1, 0, 1, 0))
	hueHit.ZIndex = 3

	local h, s, v = (opts.value or white):ToHSV()
	local obj = {Value = opts.value or white}

	local function apply(silent)
		local color = Color3.fromHSV(h, s, v)
		obj.Value, swatch.BackgroundColor3, palette.BackgroundColor3 = color, color, Color3.fromHSV(h, 1, 1)
		cursor.Position, hueCursor.Position = UDim2.new(s, 0, 1 - v, 0), UDim2.new(0, 0, h, 0)
		library.flags[flag] = color:ToHex()
		fire(flag, color)
		if not silent and opts.callback then task.spawn(opts.callback, color) end
	end

	function obj:Set(c, silent)
		if type(c) == "string" then c = Color3.fromHex(c) end
		h, s, v = c:ToHSV()
		apply(silent)
	end

	function obj:Get() return obj.Value end

	drag(paletteHit, function(p)
		s = math.clamp((p.X - palette.AbsolutePosition.X) / palette.AbsoluteSize.X, 0, 1)
		v = 1 - math.clamp((p.Y - palette.AbsolutePosition.Y) / palette.AbsoluteSize.Y, 0, 1)
		apply()
	end)

	drag(hueHit, function(p)
		h = math.clamp((p.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
		apply()
	end)

	hit.MouseButton1Click:Connect(function() openPopup(pop, swatch) end)
	library.setters[flag], library.controls[flag] = function(c) obj:Set(c) end, obj
	apply(true)
	return obj
end

local bindNames = {MouseButton1 = "m1", MouseButton2 = "m2", MouseButton3 = "m3"}
local function bindLabel(name) return bindNames[name] or string.lower(name) end

function Column:Toggle(opts)
	local flag = opts.flag or opts.text
	local row = hitbox(self.holder, UDim2.new(1, 0, 0, 18))
	local square = box(row, theme.control, UDim2.new(0, 10, 0, 10), UDim2.new(0, 1, 0.5, -5), theme.controlEdge)
	shade(square, Color3.fromRGB(190, 190, 195))
	local squareInline = square:FindFirstChild("InLine")
	local label = text(row, opts.text, UDim2.new(1, -17, 1, 0), UDim2.new(0, 17, 0, 0), nil, boldFont)
	label.TextColor3 = theme.textOff

	local obj = {Value = false, right = 1}

	local function reserve(width)
		local x = obj.right
		obj.right = obj.right + width + 6
		return x
	end

	row.MouseEnter:Connect(function() if not obj.Value then tween(label, "TextColor3", theme.text) end end)
	row.MouseLeave:Connect(function() if not obj.Value then tween(label, "TextColor3", theme.textOff) end end)

	function obj:Set(on, silent)
		obj.Value = on and true or false
		library.flags[flag] = obj.Value
		tween(square, "BackgroundColor3", obj.Value and theme.accent or theme.control)
		tween(squareInline, "Color", obj.Value and theme.accentEdge or theme.controlEdge)
		tween(label, "TextColor3", obj.Value and theme.text or theme.textOff)
		fire(flag, obj.Value)
		if not silent and opts.callback then task.spawn(opts.callback, obj.Value) end
	end

	function obj:Get() return obj.Value end

	function obj:AddColor(copts)
		copts = copts or {}
		copts.flag = copts.flag or (flag .. "_color" .. tostring(obj.right))
		return buildPicker(row, copts, reserve(22))
	end

	function obj:AddKeybind(kopts)
		kopts = kopts or {}
		local kflag = kopts.flag or (flag .. "_bind")
		local x = reserve(34)
		local btn = Instance.new("TextButton", row)
		btn.AutoButtonColor, btn.BackgroundTransparency, btn.BorderSizePixel = false, 1, 0
		btn.Size, btn.Position = UDim2.new(0, 34, 1, 0), UDim2.new(1, -(x + 34), 0, 0)
		btn.FontFace, btn.TextSize, btn.TextColor3, btn.TextXAlignment = uiFont, 12, theme.text, Enum.TextXAlignment.Right

		local bind = {Value = typeof(kopts.value) == "EnumItem" and kopts.value.Name or kopts.value, Held = false}
		local listening = false

		function bind:IsHeld() return bind.Held end

		local function matches(i) return bind.Value ~= nil and (i.KeyCode.Name == bind.Value or i.UserInputType.Name == bind.Value) end

		local function render()
			btn.Text = listening and "..." or (bind.Value and bindLabel(bind.Value) or "none")
			btn.TextColor3 = listening and theme.accent or theme.text
		end

		btn.MouseButton1Click:Connect(function() listening = true; render() end)

		UIS.InputBegan:Connect(function(i, processed)
			if listening then
				local name
				if i.KeyCode ~= Enum.KeyCode.Unknown then name = i.KeyCode.Name
				elseif i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.MouseButton3 then name = i.UserInputType.Name end
				if not name then return end
				listening, bind.Held = false, false
				bind.Value = name ~= "Escape" and name or nil
				library.flags[kflag] = bind.Value
				render()
				return
			end
			if not processed and matches(i) then
				bind.Held = true
				if kopts.toggle then obj:Set(not obj.Value) end
			end
		end)

		UIS.InputEnded:Connect(function(i) if matches(i) then bind.Held = false end end)
		library.setters[kflag] = function(v) bind.Value = v; bind.Held = false; render() end
		library.controls[kflag], library.flags[kflag] = bind, bind.Value
		render()
		return bind
	end

	row.MouseButton1Click:Connect(function() obj:Set(not obj.Value) end)
	library.setters[flag], library.controls[flag] = function(v) obj:Set(v) end, obj
	obj:Set(opts.value == true, true)
	return obj
end

function Column:Button(opts)
	local btnBox = box(self.holder, theme.control, UDim2.new(1, -2, 0, 20), nil, theme.controlEdge)
	shade(btnBox, Color3.fromRGB(190, 190, 195))
	local b = Instance.new("TextButton", btnBox)
	b.AutoButtonColor, b.BackgroundTransparency, b.BorderSizePixel = false, 1, 0
	b.Size, b.FontFace, b.TextSize, b.TextColor3 = UDim2.new(1, 0, 1, 0), boldFont, 12, theme.text
	b.TextTruncate, b.Text = Enum.TextTruncate.AtEnd, opts.text

	b.MouseEnter:Connect(function() tween(b, "TextColor3", theme.accent) end)
	b.MouseLeave:Connect(function() tween(b, "TextColor3", theme.text) end)
	b.MouseButton1Down:Connect(function() tween(btnBox, "BackgroundColor3", theme.field, 0.06) end)
	b.MouseButton1Up:Connect(function() tween(btnBox, "BackgroundColor3", theme.control, 0.15) end)
	b.MouseButton1Click:Connect(function() if opts.callback then task.spawn(opts.callback) end end)
	return btnBox
end

function Column:Slider(opts)
	local flag = opts.flag or opts.text
	local min, max, step = opts.min or 0, opts.max or 100, opts.step or 1
	local holder = Instance.new("Frame", self.holder)
	holder.BackgroundTransparency, holder.BorderSizePixel, holder.Size = 1, 0, UDim2.new(1, 0, 0, 34)

	text(holder, opts.text, UDim2.new(1, -46, 0, 16), UDim2.new(0, 1, 0, 0), nil, boldFont)
	local valueText = text(holder, "", UDim2.new(0, 44, 0, 16), UDim2.new(1, -44, 0, 0), Enum.TextXAlignment.Right)
	valueText.TextTransparency = 1

	local track = box(holder, theme.control, UDim2.new(1, -2, 0, 6), UDim2.new(0, 1, 0, 24), theme.controlEdge)
	local inner = Instance.new("Frame", track)
	inner.BackgroundTransparency, inner.BorderSizePixel, inner.Position, inner.Size = 1, 0, UDim2.new(0, 1, 0, 1), UDim2.new(1, -2, 1, -2)
	local fill = frame(inner, theme.accent, UDim2.new(0, 0, 1, 0))
	shade(fill, Color3.fromRGB(160, 160, 168))
	local hit = hitbox(holder, UDim2.new(1, 0, 0, 20), UDim2.new(0, 0, 0, 16))

	local hover, dragging = false, false
	local function refreshValue() tween(valueText, "TextTransparency", (hover or dragging) and 0 or 1) end
	hit.MouseEnter:Connect(function() hover = true; refreshValue() end)
	hit.MouseLeave:Connect(function() hover = false; refreshValue() end)

	local obj = {Value = min}

	function obj:Set(v, silent)
		v = tonumber(string.format("%.3f", math.clamp(math.round((v - min) / step) * step + min, min, max)))
		obj.Value, library.flags[flag], valueText.Text = v, v, tostring(v)
		tween(fill, "Size", UDim2.new((v - min) / (max - min), 0, 1, 0), 0.05)
		fire(flag, v)
		if not silent and opts.callback then task.spawn(opts.callback, v) end
	end

	function obj:Get() return obj.Value end

	drag(hit, function(p) obj:Set(min + (max - min) * math.clamp((p.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)) end, function(active) dragging = active; refreshValue() end)
	library.setters[flag], library.controls[flag] = function(v) obj:Set(v) end, obj
	obj:Set(opts.value or min, true)
	return obj
end

function Column:Dropdown(opts)
	local flag = opts.flag or opts.text
	local multi, titled = opts.multi, opts.text ~= nil
	local holder = Instance.new("Frame", self.holder)
	holder.BackgroundTransparency, holder.BorderSizePixel, holder.Size = 1, 0, UDim2.new(1, 0, 0, titled and 40 or 24)

	if titled then text(holder, opts.text, UDim2.new(1, 0, 0, 16), UDim2.new(0, 1, 0, 0), nil, boldFont) end

	local pop = box(library.main, theme.window, UDim2.new(), nil, theme.inline)
	pop.Visible, pop.ZIndex = false, 20
	local list = Instance.new("ScrollingFrame", pop)
	list.BackgroundTransparency, list.BorderSizePixel, list.Active = 1, 0, true
	list.Size, list.ScrollBarThickness, list.ScrollBarImageColor3 = UDim2.new(1, 0, 1, 0), 3, theme.accent
	list.CanvasSize, list.AutomaticCanvasSize = UDim2.new(), Enum.AutomaticSize.Y
	Instance.new("UIListLayout", list).SortOrder = Enum.SortOrder.LayoutOrder
	local listPad = Instance.new("UIPadding", list)
	listPad.PaddingTop, listPad.PaddingBottom, listPad.PaddingLeft, listPad.PaddingRight = UDim.new(0, 2), UDim.new(0, 2), UDim.new(0, 2), UDim.new(0, 2)

	local field = box(holder, theme.field, UDim2.new(1, -2, 0, 22), UDim2.new(0, 1, 0, titled and 18 or 1), theme.border)
	shade(field, Color3.fromRGB(200, 200, 205))
	local fieldEdge = field.InLine
	local valueText = text(field, "", UDim2.new(1, -28, 1, 0), UDim2.new(0, 8, 0, 0))
	valueText.TextTruncate = Enum.TextTruncate.AtEnd

	local arrow = frame(field, white, UDim2.fromOffset(7, 4), UDim2.new(1, -15, 0.5, -2))
	arrow.BackgroundTransparency = 1
	local pixels = {}
	for i = 1, 4 do pixels[i] = frame(arrow, theme.dim, UDim2.fromOffset(9 - i * 2, 1), UDim2.fromOffset(i - 1, i - 1)) end

	local hit = hitbox(field, UDim2.new(1, 0, 1, 0))
	hit.MouseEnter:Connect(function() tween(valueText, "TextColor3", white); if not pop.Visible then tween(fieldEdge, "Color", theme.inline) end end)
	hit.MouseLeave:Connect(function() tween(valueText, "TextColor3", theme.text); if not pop.Visible then tween(fieldEdge, "Color", theme.border) end end)

	pop:GetPropertyChangedSignal("Visible"):Connect(function()
		local open = pop.Visible
		for i, pixel in ipairs(pixels) do
			pixel.Position = UDim2.fromOffset(i - 1, open and 4 - i or i - 1)
			tween(pixel, "BackgroundColor3", open and theme.accent or theme.dim)
		end
		tween(fieldEdge, "Color", open and theme.accentEdge or theme.border)
	end)

	local rows, order, count = {}, {}, 0
	local obj = {Value = multi and order or nil}

	local function position(name) return multi and table.find(order, name) or (obj.Value == name and 1 or nil) end

	local function paint(name)
		local row, index = rows[name], position(name)
		local picked = index ~= nil
		tween(row.item, "BackgroundColor3", picked and not multi and theme.selected or (row.hover and theme.field or theme.window), 0.1)
		row.bar.Visible = picked and not multi
		row.index.Text = multi and index and tostring(index) or ""
		tween(row.label, "TextColor3", picked and (multi and white or theme.accent) or (row.hover and white or theme.text))
		if multi then
			tween(row.check, "BackgroundColor3", picked and theme.accent or theme.control)
			tween(row.check.InLine, "Color", picked and theme.accentEdge or theme.controlEdge)
		end
	end

	local function commit(silent)
		for name in pairs(rows) do paint(name) end
		local value = multi and table.clone(order) or obj.Value
		valueText.Text = multi and (#order > 0 and table.concat(order, ", ") or "none") or (obj.Value or "")
		library.flags[flag] = value
		fire(flag, value)
		if not silent and opts.callback then task.spawn(opts.callback, value) end
	end

	function obj:SetValues(values)
		for _, row in pairs(rows) do row.item:Destroy() end
		rows, count = {}, #values
		for _, name in ipairs(values) do
			local item = hitbox(list, UDim2.new(1, 0, 0, 20))
			item.BackgroundTransparency, item.BackgroundColor3 = 0, theme.window
			local row = {item = item, hover = false}
			row.bar = frame(item, theme.accent, UDim2.new(0, 2, 1, 0))
			row.bar.Visible = false
			if multi then
				row.check = box(item, theme.control, UDim2.fromOffset(10, 10), UDim2.new(0, 8, 0.5, -5), theme.controlEdge)
				shade(row.check, Color3.fromRGB(190, 190, 195))
			end
			row.label = text(item, name, UDim2.new(1, -34, 1, 0), UDim2.new(0, multi and 25 or 10, 0, 0))
			row.index = text(item, "", UDim2.new(0, 18, 1, 0), UDim2.new(1, -22, 0, 0), Enum.TextXAlignment.Right, boldFont)
			row.index.TextColor3 = theme.accent
			rows[name] = row
			item.MouseEnter:Connect(function() row.hover = true; paint(name) end)
			item.MouseLeave:Connect(function() row.hover = false; paint(name) end)
			item.MouseButton1Click:Connect(function()
				if multi then
					local at = table.find(order, name)
					if at then table.remove(order, at) else table.insert(order, name) end
					commit()
				else
					obj:Set(name)
					closePopup()
				end
			end)
		end
		if multi then
			for i = #order, 1, -1 do if not rows[order[i]] then table.remove(order, i) end end
		elseif not rows[obj.Value] then obj.Value = nil end
		commit(true)
	end

	function obj:Set(v, silent)
		if multi then
			table.clear(order)
			for _, name in ipairs(type(v) == "table" and v or {v}) do
				if rows[name] and not table.find(order, name) then table.insert(order, name) end
			end
		elseif rows[v] then obj.Value = v else return end
		commit(silent)
	end

	obj.SetValue = obj.Set
	function obj:Get() return multi and table.clone(order) or obj.Value end
	function obj:Has(name) return position(name) ~= nil end

	hit.MouseButton1Click:Connect(function()
		pop.Size = UDim2.new(0, field.AbsoluteSize.X, 0, math.min(count, 8) * 20 + 4)
		openPopup(pop, field)
	end)

	library.setters[flag], library.controls[flag] = function(v) obj:Set(v) end, obj
	obj:SetValues(opts.items)
	obj:Set(opts.value or (not multi and opts.items[1] or nil), true)
	return obj
end

