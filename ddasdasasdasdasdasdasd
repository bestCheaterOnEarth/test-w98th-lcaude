	row.BackgroundTransparency, row.BorderSizePixel, row.Size = 1, 0, UDim2.new(1, 0, 0, 18)
	text(row, opts.text, UDim2.new(1, -30, 1, 0), UDim2.new(0, 1, 0, 0), nil, boldFont)
	return buildPicker(row, opts, 1)
end

function Column:Preview(opts)
	local holder = Instance.new("Frame", self.holder)
	holder.BackgroundTransparency, holder.BorderSizePixel, holder.Size = 1, 0, UDim2.new(1, 0, 0, opts.height or 130)
	text(holder, opts.text or "preview", UDim2.new(1, 0, 0, 16), UDim2.new(0, 1, 0, 0), nil, boldFont)
	local view = box(holder, Color3.fromRGB(12, 12, 14), UDim2.new(1, -2, 1, -22), UDim2.new(0, 1, 0, 20), theme.border)
	view.ClipsDescendants = true
	local img = Instance.new("ImageLabel", view)
	img.BackgroundTransparency, img.BorderSizePixel, img.AnchorPoint = 1, 0, Vector2.new(0.5, 0.5)
	img.Position, img.Size, img.ScaleType = UDim2.new(0.5, 0, 0.5, 0), UDim2.new(0.85, 0, 0.85, 0), Enum.ScaleType.Fit
	local empty = text(view, "no preview", UDim2.new(1, 0, 1, 0), UDim2.new(), Enum.TextXAlignment.Center)
	empty.TextColor3, empty.Visible = theme.dim, false

	local last
	local function update()
		local item = library.flags[opts.image]
		if not item then return end
		local skin = opts.skin and library.flags[opts.skin] or nil
		local source = opts.resolve(item, skin)
		if source == last then return end
		last = source
		empty.Visible = source == nil
		if not source then img.Image = ""; return end
		img.ImageTransparency, img.Image = 1, source
		tween(img, "ImageTransparency", 0, 0.25)
	end

	library.listen(opts.image, update)
	if opts.skin then library.listen(opts.skin, update) end
	update()
	return holder
end

function library:Window(title)
	local parent = (gethui and gethui()) or localPlayer:WaitForChild("PlayerGui")
	if parent:FindFirstChild("Distort") then parent.Distort:Destroy() end

	local gui = Instance.new("ScreenGui", parent)
	gui.Name, gui.ResetOnSpawn, gui.ZIndexBehavior = "Distort", false, Enum.ZIndexBehavior.Sibling
	library.gui = gui

	local main = box(gui, theme.window, UDim2.new(0, 560, 0, 440), UDim2.new(0.5, -280, 0.5, -220), theme.inline)
	main.Name, library.main = "Main", main

	local topLine = frame(main, theme.accent, UDim2.new(1, -2, 0, 1), UDim2.new(0, 1, 0, 1))
	local topGradient = Instance.new("UIGradient", topLine)
	topGradient.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, theme.headline), ColorSequenceKeypoint.new(0.5, theme.accent), ColorSequenceKeypoint.new(1, theme.headline)})

	local bar = frame(main, theme.window, UDim2.new(1, 0, 0, 42), UDim2.new(0, 0, 0, 4))
	bar.BackgroundTransparency = 1
	local logoText = string.upper(title or "distort")
	local function logoLayer(color, dx, dy, transparency)
		local l = text(bar, logoText, UDim2.new(1, 0, 1, 0), UDim2.new(0, dx, 0, dy), Enum.TextXAlignment.Center, logoFont)
		l.TextSize, l.TextColor3, l.TextTransparency = 34, color, transparency
		return l
	end
	logoLayer(Color3.fromRGB(255, 60, 120), 2, 1, 0.5)
	logoLayer(theme.accent, -2, -1, 0.5)
	local logo = logoLayer(white, 0, 0, 0)
	Instance.new("UIGradient", logo).Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 40, 60)), ColorSequenceKeypoint.new(0.45, Color3.fromRGB(235, 110, 150)), ColorSequenceKeypoint.new(0.75, Color3.fromRGB(240, 230, 238)), ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 105, 120))})
	for _, y in ipairs({9, 16, 23, 30}) do
		local scan = frame(bar, theme.window, UDim2.new(1, 0, 0, 1), UDim2.new(0, 0, 0, y))
		scan.BackgroundTransparency, scan.ZIndex = 0.35, 2
	end

	local tabBar = box(main, theme.panel, UDim2.new(1, -20, 0, 26), UDim2.new(0, 10, 0, 48), theme.border)
	local tabList = Instance.new("UIListLayout", tabBar)
	tabList.FillDirection, tabList.HorizontalAlignment, tabList.VerticalAlignment, tabList.Padding, tabList.SortOrder = Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center, UDim.new(0, 8), Enum.SortOrder.LayoutOrder

	local body = Instance.new("Frame", main)
	body.Name, body.BackgroundTransparency, body.BorderSizePixel = "Inside", 1, 0
	body.Position, body.Size = UDim2.new(0, 10, 0, 84), UDim2.new(1, -20, 1, -94)

	local function column(page, pos)
		local inner = box(page, theme.panel, UDim2.new(0.5, -5, 1, 0), pos, theme.border)
		local header = Instance.new("Frame", inner)
		header.Name, header.BackgroundTransparency, header.BorderSizePixel = "Header", 1, 0
		header.Position, header.Size, header.Visible = UDim2.new(0, 1, 0, 1), UDim2.new(1, -2, 0, HEADER - 1), false
		local line = frame(inner, theme.headline, UDim2.new(1, -2, 0, 1), UDim2.new(0, 1, 0, HEADER))
		line.Name, line.Visible = "HeaderLine", false
		local scroll = Instance.new("ScrollingFrame", inner)
		scroll.BackgroundTransparency, scroll.BorderSizePixel, scroll.Active = 1, 0, true
		scroll.Size, scroll.ScrollBarThickness = UDim2.new(1, 0, 1, 0), 0
		scroll.CanvasSize, scroll.AutomaticCanvasSize = UDim2.new(), Enum.AutomaticSize.Y
		local list = Instance.new("UIListLayout", scroll)
		list.Padding, list.SortOrder = UDim.new(0, 2), Enum.SortOrder.LayoutOrder
		local pad = Instance.new("UIPadding", scroll)
		pad.PaddingTop, pad.PaddingBottom, pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 10)
		return setmetatable({holder = scroll, scroll = scroll, header = header, line = line, panel = inner}, Column)
	end

	local window, current, count = {Gui = gui}, nil, 0

	function window:Tab(name)
		count = count + 1
		local page = Instance.new("Frame", body)
		page.Name, page.BackgroundTransparency, page.BorderSizePixel, page.Size, page.Visible = name, 1, 0, UDim2.new(1, 0, 1, 0), false
		local tab = {Left = column(page, UDim2.new()), Right = column(page, UDim2.new(0.5, 5, 0, 0))}

		if count > 1 then
			local slash = text(tabBar, "/", UDim2.new(0, 6, 1, 0), UDim2.new(), Enum.TextXAlignment.Center, boldFont)
			slash.TextColor3, slash.LayoutOrder = theme.sep, count * 2 - 1
		end
		local btn = Instance.new("TextButton", tabBar)
		btn.AutoButtonColor, btn.BackgroundTransparency, btn.BorderSizePixel, btn.AutomaticSize = false, 1, 0, Enum.AutomaticSize.X
		btn.Size, btn.FontFace, btn.TextSize, btn.TextColor3, btn.Text, btn.LayoutOrder = UDim2.new(0, 0, 1, 0), boldFont, 12, theme.text, name, count * 2

		local function open()
			closePopup()
			if current then tween(current.btn, "TextColor3", theme.text); current.page.Visible = false end
			tween(btn, "TextColor3", theme.accent)
			page.Visible = true
			current = {btn = btn, page = page}
		end

		btn.MouseEnter:Connect(function() if current.btn ~= btn then tween(btn, "TextColor3", white) end end)
		btn.MouseLeave:Connect(function() if current.btn ~= btn then tween(btn, "TextColor3", theme.text) end end)
		btn.MouseButton1Click:Connect(open)
		if not current then open() end
		return tab
	end

	local dragging, dragStart, startPos
	bar.InputBegan:Connect(function(i) if press(i) then dragging, dragStart, startPos = true, i.Position, main.Position end end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	UIS.InputEnded:Connect(function(i) if press(i) then dragging = false end end)
	UIS.InputBegan:Connect(function(i, processed) if not processed and i.KeyCode == library.key then closePopup(); main.Visible = not main.Visible end end)
	return window
end

return library
