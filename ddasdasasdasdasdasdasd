-- theme ------------------------------------------------------------------

local defaults = {
	accent = Color3.fromRGB(127, 110, 212),
	window = Color3.fromRGB(20, 20, 21),
	panel = Color3.fromRGB(16, 16, 17),
	field = Color3.fromRGB(30, 30, 32),
	control = Color3.fromRGB(46, 46, 49),
	text = Color3.fromRGB(198, 197, 204)
}
local theme = table.clone(defaults)
theme.outline = black

local function preset(over)
	local p = table.clone(defaults)
	for key, value in pairs(over) do
		p[key] = value
	end
	return p
end

library.presets = {
	default = preset({}),
	crimson = preset({accent = Color3.fromRGB(214, 60, 84)}),
	sunset = preset({accent = Color3.fromRGB(240, 140, 64)}),
	ocean = preset({
		accent = Color3.fromRGB(64, 160, 224), window = Color3.fromRGB(16, 20, 26), panel = Color3.fromRGB(12, 16, 22),
		field = Color3.fromRGB(24, 30, 38), control = Color3.fromRGB(38, 46, 58), text = Color3.fromRGB(198, 204, 212)
	}),
	mint = preset({
		accent = Color3.fromRGB(84, 200, 150), window = Color3.fromRGB(18, 22, 20), panel = Color3.fromRGB(14, 18, 16),
		field = Color3.fromRGB(26, 32, 29), control = Color3.fromRGB(40, 48, 44), text = Color3.fromRGB(198, 208, 202)
	}),
	mono = preset({
		accent = Color3.fromRGB(225, 225, 225), window = Color3.fromRGB(18, 18, 18), panel = Color3.fromRGB(12, 12, 12),
		field = Color3.fromRGB(28, 28, 28), control = Color3.fromRGB(44, 44, 44), text = Color3.fromRGB(210, 210, 210)
	})
}

local function deriveTheme()
	theme.border = theme.window:Lerp(white, 0.09)
	theme.headline = theme.window:Lerp(white, 0.11)
	theme.inline = theme.window:Lerp(theme.text, 0.3)
	theme.sep = theme.window:Lerp(theme.text, 0.25)
	theme.controlEdge = theme.control:Lerp(black, 0.25)
	theme.accentEdge = theme.accent:Lerp(black, 0.3)
	theme.selected = theme.window:Lerp(theme.accent, 0.12)
	theme.textOff = theme.text:Lerp(theme.window, 0.2)
	theme.dim = theme.text:Lerp(theme.window, 0.4)
end
deriveTheme()

-- registry: objects created with a theme key (string) are recolored live;
-- state-driven controls (toggle, dropdown rows, tabs...) repaint through refreshers
local registry, refreshers = {}, {}

local function themed(obj, prop, value)
	if type(value) == "string" then
		table.insert(registry, {obj, prop, value})
		value = theme[value]
	end
	obj[prop] = value
end

local function applyTheme()
	deriveTheme()
	for i = #registry, 1, -1 do
		local entry = registry[i]
		if entry[1].Parent then
			entry[1][entry[2]] = theme[entry[3]]
		else
			table.remove(registry, i)
		end
	end
	for _, fn in ipairs(refreshers) do
		fn()
	end
end

function library:SetTheme(key, value)
	theme[key] = value
	applyTheme()
end

-- fonts ------------------------------------------------------------------

local fallback = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)

local function loadFont(name, url)
	local ok, result = pcall(function()
		local ttf, json = name .. ".ttf", name .. ".json"
		if not isfile(ttf) then
			writefile(ttf, game:HttpGet(url))
		end
		writefile(json, HttpService:JSONEncode({
			name = name,
			faces = {{name = name, weight = 400, style = "Regular", assetId = getcustomasset(ttf)}}
		}))
		return Font.new(getcustomasset(json))
	end)
	return ok and result or fallback
end

local uiFont = loadFont("tahomaxp", fontUiUrl)
local boldFont = loadFont("tahomaboldxp", fontBoldUrl)
local logoFont = loadFont("gothambold", fontLogoUrl)

-- helpers ----------------------------------------------------------------

local function guiParent()
	return (gethui and gethui()) or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

local function tween(obj, prop, value, t)
	TweenService:Create(obj, TweenInfo.new(t or 0.15), {[prop] = value}):Play()
end

local function fire(flag, value)
	for _, fn in ipairs(library.listeners[flag] or {}) do
		fn(value)
	end
end

function library.listen(flag, fn)
	library.listeners[flag] = library.listeners[flag] or {}
	table.insert(library.listeners[flag], fn)
end

local function measure(str, font, size)
	local ok, width = pcall(function()
		local params = Instance.new("GetTextBoundsParams")
		params.Text = str
		params.Font = font
		params.Size = size
		params.Width = 10000
		return game:GetService("TextService"):GetTextBoundsAsync(params).X
	end)
	return ok and width or #str * 7
end

local function frame(parent, color, size, pos)
	local f = Instance.new("Frame", parent)
	f.BorderSizePixel = 0
	f.Size = size
	f.Position = pos or UDim2.new()
	themed(f, "BackgroundColor3", color)
	return f
end

local function stroke(obj, color, thickness, name, position)
	local s = Instance.new("UIStroke")
	s.Name = name or "Stroke"
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.LineJoinMode = Enum.LineJoinMode.Miter
	s.BorderStrokePosition = position or Enum.BorderStrokePosition.Outer
	s.Thickness = thickness or 1
	s.Parent = obj
	themed(s, "Color", color or "border")
	return s
end

local function box(parent, color, size, pos, inlineColor)
	local f = frame(parent, color, size, pos)
	stroke(f, "outline", 1, "OutLine", Enum.BorderStrokePosition.Outer)
	stroke(f, inlineColor or "border", 1, "InLine", Enum.BorderStrokePosition.Inner)
	return f
end

local function shade(obj, bottom)
	local g = Instance.new("UIGradient", obj)
	g.Rotation = 90
	g.Color = ColorSequence.new(white, bottom or Color3.fromRGB(175, 175, 180))
	return g
end

local function text(parent, str, size, pos, align, font, color)
	local l = Instance.new("TextLabel", parent)
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.FontFace = font or uiFont
	l.TextSize = 12
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	l.Text = str
	l.Size = size
	l.Position = pos or UDim2.new()
	themed(l, "TextColor3", color or "text")
	return l
end

local function textStroke(label)
	local s = Instance.new("UIStroke")
	s.Color = black
	s.Thickness = 1
	s.LineJoinMode = Enum.LineJoinMode.Miter
	s.Parent = label
	return s
end

local function hitbox(parent, size, pos)
	local b = Instance.new("TextButton", parent)
	b.AutoButtonColor = false
	b.Text = ""
	b.BackgroundTransparency = 1
	b.BorderSizePixel = 0
	b.Size = size
	b.Position = pos or UDim2.new()
	return b
end

local function press(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function drag(target, fn, state)
	local active = false
	target.InputBegan:Connect(function(i)
		if press(i) then
			active = true
			if state then state(true) end
			fn(i.Position)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if active and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fn(i.Position)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if press(i) and active then
			active = false
			if state then state(false) end
		end
	end)
end

local function inside(obj, p)
	local a, s = obj.AbsolutePosition, obj.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

-- popups (color picker / keybind mode) -------------------------------------

local openFrame, openAnchor

local function closePopup()
	if openFrame then
		openFrame.Visible = false
		openFrame = nil
	end
end

local function popup(size)
	local pop = box(library.main, "window", size, nil, "inline")
	pop.Visible = false
	pop.Active = true
	pop.ZIndex = 20
	return pop
end

local function openPopup(pop, anchor)
	local show = openFrame ~= pop
	closePopup()
	if show then
		local main = library.main
		pop.Position = UDim2.fromOffset(
			math.min(anchor.AbsolutePosition.X - main.AbsolutePosition.X, main.AbsoluteSize.X - pop.Size.X.Offset - 6),
			math.min(anchor.AbsolutePosition.Y - main.AbsolutePosition.Y + anchor.AbsoluteSize.Y + 3, main.AbsoluteSize.Y - pop.Size.Y.Offset - 6)
		)
		pop.Visible = true
		openFrame, openAnchor = pop, anchor
	end
end

UIS.InputBegan:Connect(function(i)
	if openFrame and press(i) and not inside(openFrame, i.Position) and not inside(openAnchor, i.Position) then
		closePopup()
	end
end)

-- configs ----------------------------------------------------------------

local function ensureDir()
	if not isfolder(configDir) then
		makefolder(configDir)
	end
end

function library.configs()
	local names = {}
	if listfiles and isfolder and isfolder(configDir) then
		for _, path in ipairs(listfiles(configDir)) do
			local name = path:match("([^/\\]+)%.json$")
			if name then
				table.insert(names, name)
			end
		end
	end
	table.sort(names)
	return names
end

function library.exportConfig()
	local data = {}
	for flag, value in pairs(library.flags) do
		if flag:sub(1, 1) ~= "_" then
			data[flag] = value
		end
	end
	return HttpService:JSONEncode(data)
end

function library.importConfig(json)
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if not (ok and type(data) == "table") then return false end
	for flag, value in pairs(data) do
		if library.setters[flag] then
			library.setters[flag](value)
		end
	end
	return true
end

function library.saveConfig(name)
	if not (writefile and name and name ~= "") then return false end
	ensureDir()
	writefile(configDir .. "/" .. name .. ".json", library.exportConfig())
	return true
end

function library.loadConfig(name)
	local path = configDir .. "/" .. tostring(name) .. ".json"
	return name and isfile and isfile(path) and library.importConfig(readfile(path)) or false
end

function library.deleteConfig(name)
	local path = configDir .. "/" .. tostring(name) .. ".json"
	if delfile and isfile and isfile(path) then
		delfile(path)
		return true
	end
	return false
end

function library.autoloadName()
	local path = configDir .. "/autoload.txt"
	local name = isfile and isfile(path) and readfile(path) or ""
	return name ~= "" and name or nil
end

function library.setAutoload(name)
	ensureDir()
	writefile(configDir .. "/autoload.txt", name or "")
end

function library.autoload()
	local name = library.autoloadName()
	return name and library.loadConfig(name)
end

-- hud --------------------------------------------------------------------

local hudGui, hudArea, watermark, watermarkLabel, indicator, indicatorMain, indicatorSub, indicatorShown

local function hud()
	if hudGui and hudGui.Parent then
		return hudGui
	end
	local parent = guiParent()
	local old = parent:FindFirstChild("DistortHud")
	if old then
		old:Destroy()
	end

	hudGui = Instance.new("ScreenGui", parent)
	hudGui.Name = "DistortHud"
	hudGui.ResetOnSpawn = false
	hudGui.IgnoreGuiInset = true
	hudGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	hudArea = Instance.new("Frame", hudGui)
	hudArea.Name = "Notifications"
	hudArea.BackgroundTransparency = 1
	hudArea.BorderSizePixel = 0
	hudArea.Position = UDim2.fromOffset(8, 8)
	hudArea.Size = UDim2.fromOffset(400, 300)
	local areaList = Instance.new("UIListLayout", hudArea)
	areaList.Padding = UDim.new(0, 6)
	areaList.SortOrder = Enum.SortOrder.LayoutOrder

	watermark = box(hudGui, "window", UDim2.fromOffset(100, 22), UDim2.new(0.5, 0, 0, 8), "border")
	watermark.Name = "Watermark"
	watermark.AnchorPoint = Vector2.new(0.5, 0)
	watermark.Visible = false
	watermark.ZIndex = 5
	shade(watermark, Color3.fromRGB(190, 190, 195))
	frame(watermark, "accent", UDim2.new(1, 0, 0, 2)).ZIndex = 6
	watermarkLabel = text(watermark, "", UDim2.new(1, 0, 1, -2), UDim2.new(0, 0, 0, 2), Enum.TextXAlignment.Center, boldFont)
	watermarkLabel.ZIndex = 6
	textStroke(watermarkLabel)

	indicator = Instance.new("Frame", hudGui)
	indicator.Name = "Indicator"
	indicator.BackgroundTransparency = 1
	indicator.BorderSizePixel = 0
	indicator.AnchorPoint = Vector2.new(0.5, 0)
	indicator.Size = UDim2.fromOffset(300, 46)
	indicator.Position = UDim2.new(0.5, 0, 0.62, 14)
	indicatorShown = false

	indicatorMain = text(indicator, "", UDim2.new(1, 0, 0, 26), UDim2.new(), Enum.TextXAlignment.Center, boldFont, white)
	indicatorMain.TextSize = 22
	indicatorMain.TextTransparency = 1
	textStroke(indicatorMain).Transparency = 1

	indicatorSub = text(indicator, "", UDim2.new(1, 0, 0, 18), UDim2.new(0, 0, 0, 26), Enum.TextXAlignment.Center, boldFont, white)
	indicatorSub.TextSize = 16
	indicatorSub.TextTransparency = 1
	textStroke(indicatorSub).Transparency = 1

	return hudGui
end

function library:SetWatermark(str)
	hud()
	watermarkLabel.Text = str
	watermark.Size = UDim2.fromOffset(measure(str, boldFont, 12) + 18, 22)
	watermark.Visible = true
end

function library:SetWatermarkVisibility(on)
	hud()
	watermark.Visible = on and watermarkLabel.Text ~= "" or false
end

function library:SetIndicator(main, sub)
	hud()
	indicatorMain.Text = main
	indicatorSub.Text = sub or ""
end

function library:SetIndicatorVisibility(on)
	hud()
	on = on and true or false
	if on == indicatorShown then return end
	indicatorShown = on
	local alpha = on and 0 or 1
	tween(indicator, "Position", UDim2.new(0.5, 0, 0.62, on and 0 or 14), 0.3)
	for _, label in ipairs({indicatorMain, indicatorSub}) do
		tween(label, "TextTransparency", alpha, 0.3)
		tween(label:FindFirstChildOfClass("UIStroke"), "Transparency", alpha, 0.3)
	end
end

function library:Notify(str, duration)
	hud()
	local width, height = measure(str, uiFont, 12) + 16, 22

	local note = box(hudArea, "window", UDim2.fromOffset(0, height), nil, "border")
	note.ClipsDescendants = true
	note.ZIndex = 10
	shade(note, Color3.fromRGB(190, 190, 195))
	frame(note, "accent", UDim2.new(0, 3, 1, 0)).ZIndex = 12

	local label = text(note, str, UDim2.new(1, -10, 1, 0), UDim2.new(0, 9, 0, 0))
	label.ZIndex = 11
	textStroke(label)

	local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(note, info, {Size = UDim2.fromOffset(width, height)}):Play()

	task.spawn(function()
		task.wait(duration or 5)
		local out = TweenService:Create(note, info, {Size = UDim2.fromOffset(0, height)})
		out:Play()
		out.Completed:Wait()
		note:Destroy()
	end)
end

function library:Unload()
	if library.gui then
		library.gui:Destroy()
	end
	if hudGui then
		hudGui:Destroy()
	end
end

-- columns ----------------------------------------------------------------

local Column = {}
Column.__index = Column

function Column:UseHeader()
	if self.hasHeader then return end
	self.hasHeader = true
	self.header.Visible = true
	self.line.Visible = true
	self.scroll.Position = UDim2.new(0, 0, 0, headerHeight + 1)
	self.scroll.Size = UDim2.new(1, 0, 1, -(headerHeight + 1))
end

function Column:Header(str)
	self:UseHeader()
	return text(self.header, str, UDim2.new(1, 0, 1, 0), UDim2.new(), Enum.TextXAlignment.Center, boldFont, "accent")
end

function Column:Section(title)
	local row = Instance.new("Frame", self.holder)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, 18)
	text(row, title, UDim2.new(1, 0, 0, 16), UDim2.new(0, 1, 0, 1), nil, boldFont)
	frame(row, "border", UDim2.new(1, 0, 0, 1), UDim2.new(0, 0, 1, -2))
	return row
end

function Column:Label(str)
	return text(self.holder, str, UDim2.new(1, 0, 0, 16), UDim2.new(), nil, boldFont)
end

function Column:Pages(names)
	self:UseHeader()

	local list = Instance.new("UIListLayout", self.header)
	list.FillDirection = Enum.FillDirection.Horizontal
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Padding = UDim.new(0, 8)
	list.SortOrder = Enum.SortOrder.LayoutOrder

	local pages, buttons, result, active = {}, {}, {}, nil

	local function paintButtons()
		for n, button in pairs(buttons) do
			tween(button, "TextColor3", n == active and theme.accent or theme.text)
		end
	end
	table.insert(refreshers, paintButtons)

	local function show(name)
		closePopup()
		active = name
		for n, page in pairs(pages) do
			page.Visible = n == name
		end
		paintButtons()
	end

	for i, name in ipairs(names) do
		if i > 1 then
			local slash = text(self.header, "/", UDim2.new(0, 6, 1, 0), UDim2.new(), Enum.TextXAlignment.Center, boldFont, "sep")
			slash.LayoutOrder = i * 2 - 1
		end

		local button = Instance.new("TextButton", self.header)
		button.AutoButtonColor = false
		button.BackgroundTransparency = 1
		button.BorderSizePixel = 0
		button.AutomaticSize = Enum.AutomaticSize.X
		button.Size = UDim2.new(0, 0, 1, 0)
		button.FontFace = boldFont
		button.TextSize = 12
		button.TextColor3 = theme.text
		button.Text = name
		button.LayoutOrder = i * 2
		button.MouseButton1Click:Connect(function()
			show(name)
		end)

		local page = Instance.new("Frame", self.holder)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.Size = UDim2.new(1, 0, 0, 0)
		page.AutomaticSize = Enum.AutomaticSize.Y
		page.Visible = false
		local pageList = Instance.new("UIListLayout", page)
		pageList.Padding = UDim.new(0, 2)
		pageList.SortOrder = Enum.SortOrder.LayoutOrder

		pages[name] = page
		buttons[name] = button
		table.insert(result, setmetatable({holder = page, scroll = self.scroll}, Column))
	end

	show(names[1])
	return table.unpack(result)
end

local function buildPicker(row, opts, offset)
	local flag = opts.flag or opts.text or tostring(row)

	local swatch = box(row, white, UDim2.new(0, 22, 0, 10), UDim2.new(1, -(offset + 22), 0.5, -5), Color3.fromRGB(30, 30, 30))
	local hit = hitbox(swatch, UDim2.new(1, 0, 1, 0))
	hit.ZIndex = 3

	local pop = popup(UDim2.new(0, 160, 0, 124))

	local palette = box(pop, Color3.new(1, 0, 0), UDim2.new(1, -36, 1, -14), UDim2.new(0, 7, 0, 7), "controlEdge")
	Instance.new("UIGradient", frame(palette, white, UDim2.new(1, 0, 1, 0))).Transparency = NumberSequence.new(0, 1)
	local fade = Instance.new("UIGradient", frame(palette, black, UDim2.new(1, 0, 1, 0)))
	fade.Rotation = 90
	fade.Transparency = NumberSequence.new(1, 0)
	local cursor = frame(palette, white, UDim2.new(0, 4, 0, 4))
	cursor.AnchorPoint = Vector2.new(0.5, 0.5)
	cursor.ZIndex = 2
	stroke(cursor, black)
	local paletteHit = hitbox(palette, UDim2.new(1, 0, 1, 0))
	paletteHit.ZIndex = 3

	local hueBar = box(pop, white, UDim2.new(0, 16, 1, -14), UDim2.new(1, -24, 0, 7), "controlEdge")
	local keys = {}
	for n = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(n / 6, Color3.fromHSV(n / 6, 1, 1)))
	end
	local hueGradient = Instance.new("UIGradient", hueBar)
	hueGradient.Rotation = 90
	hueGradient.Color = ColorSequence.new(keys)
	local hueCursor = frame(hueBar, white, UDim2.new(1, 0, 0, 2))
	hueCursor.AnchorPoint = Vector2.new(0, 0.5)
	hueCursor.ZIndex = 2
	stroke(hueCursor, black)
	local hueHit = hitbox(hueBar, UDim2.new(1, 0, 1, 0))
	hueHit.ZIndex = 3

	local h, s, v = (opts.value or white):ToHSV()
	local obj = {Value = opts.value or white}

	local function apply(silent)
		local color = Color3.fromHSV(h, s, v)
		obj.Value = color
		swatch.BackgroundColor3 = color
		palette.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		cursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCursor.Position = UDim2.new(0, 0, h, 0)
		library.flags[flag] = color:ToHex()
		fire(flag, color)
		if not silent and opts.callback then
			task.spawn(opts.callback, color)
		end
	end

	function obj:Set(c, silent)
		if type(c) == "string" then
			c = Color3.fromHex(c)
		end
		h, s, v = c:ToHSV()
		apply(silent)
	end

	function obj:Get()
		return obj.Value
	end

	drag(paletteHit, function(p)
		s = math.clamp((p.X - palette.AbsolutePosition.X) / palette.AbsoluteSize.X, 0, 1)
		v = 1 - math.clamp((p.Y - palette.AbsolutePosition.Y) / palette.AbsoluteSize.Y, 0, 1)
		apply()
	end)

	drag(hueHit, function(p)
		h = math.clamp((p.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
		apply()
	end)

	hit.MouseButton1Click:Connect(function()
		openPopup(pop, swatch)
	end)

	library.setters[flag] = function(c) obj:Set(c) end
	library.controls[flag] = obj
	apply(true)
	return obj
end

local bindNames = {MouseButton1 = "m1", MouseButton2 = "m2", MouseButton3 = "m3"}
local function bindLabel(name)
	return bindNames[name] or string.lower(name)
end

function Column:Toggle(opts)
	local flag = opts.flag or opts.text

	local row = hitbox(self.holder, UDim2.new(1, 0, 0, 16))
	local square = box(row, theme.control, UDim2.new(0, 10, 0, 10), UDim2.new(0, 1, 0.5, -5), theme.controlEdge)
	shade(square, Color3.fromRGB(190, 190, 195))
	local label = text(row, opts.text, UDim2.new(1, -17, 1, 0), UDim2.new(0, 17, 0, 0), nil, boldFont, theme.textOff)

	local obj = {Value = false, right = 1}

	local function reserve(width)
		local x = obj.right
		obj.right = obj.right + width + 6
		return x
	end

	local function paint()
		tween(square, "BackgroundColor3", obj.Value and theme.accent or theme.control)
		tween(square.InLine, "Color", obj.Value and theme.accentEdge or theme.controlEdge)
		tween(label, "TextColor3", obj.Value and theme.text or theme.textOff)
	end
	table.insert(refreshers, paint)

	row.MouseEnter:Connect(function()
		if not obj.Value then
			tween(label, "TextColor3", theme.text)
		end
	end)
	row.MouseLeave:Connect(function()
		if not obj.Value then
			tween(label, "TextColor3", theme.textOff)
		end
	end)

	function obj:Set(on, silent)
		obj.Value = on and true or false
		library.flags[flag] = obj.Value
		paint()
		fire(flag, obj.Value)
		if not silent and opts.callback then
			task.spawn(opts.callback, obj.Value)
		end
	end

	function obj:Get()
		return obj.Value
	end

	function obj:AddColor(copts)
		copts = copts or {}
		copts.flag = copts.flag or (flag .. "_color" .. tostring(obj.right))
		return buildPicker(row, copts, reserve(22))
	end

	function obj:AddKeybind(kopts)
		kopts = kopts or {}
		local kflag = kopts.flag or (flag .. "_bind")
		local x = reserve(40)

		local btn = Instance.new("TextButton", row)
		btn.AutoButtonColor = false
		btn.BackgroundTransparency = 1
		btn.BorderSizePixel = 0
		btn.Size = UDim2.new(0, 40, 1, 0)
		btn.Position = UDim2.new(1, -(x + 40), 0, 0)
		btn.FontFace = uiFont
		btn.TextSize = 12
		btn.TextXAlignment = Enum.TextXAlignment.Right

		local bind = {Value = typeof(kopts.value) == "EnumItem" and kopts.value.Name or kopts.value, Held = false, State = false, Mode = kopts.mode or "Hold"}
		local listening = false
		local modes = {"Hold", "Toggle", "Always"}

		local pop = popup(UDim2.fromOffset(64, #modes * 20 + 4))
		Instance.new("UIListLayout", pop).SortOrder = Enum.SortOrder.LayoutOrder
		local popPad = Instance.new("UIPadding", pop)
		popPad.PaddingTop = UDim.new(0, 2)
		popPad.PaddingLeft = UDim.new(0, 2)
		popPad.PaddingRight = UDim.new(0, 2)
		local items = {}

		function bind:IsHeld()
			return bind.Held
		end

		function bind:IsActive()
			if bind.Mode == "Always" or bind.Value == nil then
				return true
			end
			if bind.Mode == "Toggle" then
				return bind.State
			end
			return bind.Held
		end

		local function matches(i)
			return bind.Value ~= nil and (i.KeyCode.Name == bind.Value or i.UserInputType.Name == bind.Value)
		end

		local function render()
			local key = bind.Value and bindLabel(bind.Value) or "none"
			btn.Text = listening and "..." or (bind.Mode == "Always" and "always" or (bind.Mode == "Toggle" and key .. " t" or key))
			btn.TextColor3 = listening and theme.accent or theme.text
			for name, item in pairs(items) do
				item.TextColor3 = name == bind.Mode and theme.accent or theme.text
			end
		end
		table.insert(refreshers, render)

		local function setMode(name)
			bind.Mode = name
			bind.State = false
			library.flags[kflag .. "_mode"] = name
			render()
		end

		for i, name in ipairs(modes) do
			local item = Instance.new("TextButton", pop)
			item.AutoButtonColor = false
			item.BackgroundTransparency = 1
			item.BorderSizePixel = 0
			item.Size = UDim2.new(1, 0, 0, 20)
			item.FontFace = uiFont
			item.TextSize = 12
			item.Text = string.lower(name)
			item.ZIndex = 21
			item.LayoutOrder = i
			item.MouseButton1Click:Connect(function()
				setMode(name)
				closePopup()
			end)
			items[name] = item
		end

		btn.MouseButton1Click:Connect(function()
			listening = true
			render()
		end)

		btn.MouseButton2Click:Connect(function()
			openPopup(pop, btn)
		end)

		UIS.InputBegan:Connect(function(i, processed)
			if listening then
				local name
				if i.KeyCode ~= Enum.KeyCode.Unknown then
					name = i.KeyCode.Name
				elseif i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.MouseButton3 then
					name = i.UserInputType.Name
				end
				if not name then return end
				listening = false
				bind.Held = false
				bind.State = false
				bind.Value = name ~= "Escape" and name or nil
				library.flags[kflag] = bind.Value
				render()
				return
			end
			if not processed and matches(i) then
				bind.Held = true
				if bind.Mode == "Toggle" then
					bind.State = not bind.State
				end
				if kopts.toggle then
					obj:Set(not obj.Value)
				end
			end
		end)

		UIS.InputEnded:Connect(function(i)
			if matches(i) then
				bind.Held = false
			end
		end)

		library.setters[kflag] = function(v)
			bind.Value = v
			bind.Held = false
			bind.State = false
			render()
		end
		library.setters[kflag .. "_mode"] = function(v)
			if items[v] then
				setMode(v)
			end
		end
		library.controls[kflag] = bind
		library.flags[kflag] = bind.Value
		library.flags[kflag .. "_mode"] = bind.Mode
		render()
		return bind
	end

	row.MouseButton1Click:Connect(function()
		obj:Set(not obj.Value)
	end)

	library.setters[flag] = function(v) obj:Set(v) end
	library.controls[flag] = obj
	obj:Set(opts.value == true, true)
	return obj
end

-- standalone keybind (no toggle attached), e.g. the menu key
function Column:Keybind(opts)
	local flag = opts.flag or opts.text
	local row = Instance.new("Frame", self.holder)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, 16)
	text(row, opts.text, UDim2.new(1, -60, 1, 0), UDim2.new(0, 1, 0, 0), nil, boldFont)

	local btn = Instance.new("TextButton", row)
	btn.AutoButtonColor = false
	btn.BackgroundTransparency = 1
	btn.BorderSizePixel = 0
	btn.Size = UDim2.new(0, 56, 1, 0)
	btn.Position = UDim2.new(1, -56, 0, 0)
	btn.FontFace = uiFont
	btn.TextSize = 12
	btn.TextXAlignment = Enum.TextXAlignment.Right

	local obj = {Value = typeof(opts.value) == "EnumItem" and opts.value.Name or opts.value}
	local listening = false

	local function render()
		btn.Text = listening and "..." or (obj.Value and bindLabel(obj.Value) or "none")
		btn.TextColor3 = listening and theme.accent or theme.text
	end
	table.insert(refreshers, render)

	function obj:Set(name, silent)
		obj.Value = name
		library.flags[flag] = name
		render()
		if not silent and opts.callback then
			task.spawn(opts.callback, name)
		end
	end

	function obj:Get()
		return obj.Value
	end

	btn.MouseButton1Click:Connect(function()
		listening = true
		render()
	end)

	UIS.InputBegan:Connect(function(i)
		if listening and i.KeyCode ~= Enum.KeyCode.Unknown then
			listening = false
			obj:Set(i.KeyCode ~= Enum.KeyCode.Escape and i.KeyCode.Name or obj.Value)
		end
	end)

	library.setters[flag] = function(v) obj:Set(v) end
	library.controls[flag] = obj
	obj:Set(obj.Value, true)
	return obj
end

local function makeButton(parent, opts, size, pos)
	local btnBox = box(parent, "control", size, pos, "controlEdge")
	shade(btnBox, Color3.fromRGB(190, 190, 195))
	local b = Instance.new("TextButton", btnBox)
	b.AutoButtonColor = false
	b.BackgroundTransparency = 1
	b.BorderSizePixel = 0
	b.Size = UDim2.new(1, 0, 1, 0)
	b.FontFace = boldFont
	b.TextSize = 12
	b.TextTruncate = Enum.TextTruncate.AtEnd
	b.Text = opts.text
	themed(b, "TextColor3", "text")

	b.MouseEnter:Connect(function() tween(b, "TextColor3", theme.accent) end)
	b.MouseLeave:Connect(function() tween(b, "TextColor3", theme.text) end)
	b.MouseButton1Down:Connect(function() tween(btnBox, "BackgroundColor3", theme.field, 0.06) end)
	b.MouseButton1Up:Connect(function() tween(btnBox, "BackgroundColor3", theme.control, 0.15) end)
	b.MouseButton1Click:Connect(function()
		if opts.callback then
			task.spawn(opts.callback)
		end
	end)
	return btnBox, b
end

function Column:Button(opts)
	return makeButton(self.holder, opts, UDim2.new(1, -2, 0, 22))
end

-- several buttons side by side; returns the TextButtons
function Column:Buttons(defs)
	local row = Instance.new("Frame", self.holder)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, 22)
	local result = {}
	for i, def in ipairs(defs) do
		local cell = Instance.new("Frame", row)
		cell.BackgroundTransparency = 1
		cell.BorderSizePixel = 0
		cell.Size = UDim2.new(1 / #defs, 0, 1, 0)
		cell.Position = UDim2.new((i - 1) / #defs, 0, 0, 0)
		local _, b = makeButton(cell, def, UDim2.new(1, -5, 1, 0))
		result[i] = b
	end
	return result
end

